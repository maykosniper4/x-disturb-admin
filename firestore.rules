rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users: authenticated reads & writes for app login and admin management
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn();
      }
    }

    // Admin profile
    match /admin_profile/{adminId} {
      allow read, write: if isSignedIn();
    }

    // Roles and Permissions management
    match /roles/{roleId} {
      allow read, write: if isSignedIn();
    }

    // Audit logs tracking
    match /audit_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Phone → userId index for O(1) registered-user checks.
    match /phone_index/{phone} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /referral_codes/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /referrals/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Catalog data
    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /silent_zones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /payment_intents/{txRef} {
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || resource.data == null);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /zone_activities/{activityId} {
      allow create, read: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Legal documents (Data Security, User Agreement, Privacy Policy)
    match /app_legal_content/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
